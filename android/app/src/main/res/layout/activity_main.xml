<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F172A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Control Presentación"
        android:textColor="#E2E8F0"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Desconectado"
        android:textColor="#F8FAFC"
        android:textSize="16sp"
        android:padding="10dp"
        android:background="#1E293B"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/lastActionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Última acción: ninguna"
        android:textColor="#A5F3FC"
        android:textSize="14sp"
        android:padding="10dp"
        android:background="#0F172A"
        android:layout_marginBottom="18dp" />

    <EditText
        android:id="@+id/hostInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="IP de la Mac"
        android:textColor="#E2E8F0"
        android:textColorHint="#94A3B8"
        android:background="#1E293B"
        android:padding="14dp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/pinInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="PIN de emparejamiento"
        android:textColor="#E2E8F0"
        android:textColorHint="#94A3B8"
        android:background="#1E293B"
        android:padding="14dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Conectar / Reconectar"
        android:layout_marginBottom="14dp"
        android:backgroundTint="#22C55E" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Usa VOL+ para avanzar y VOL− para retroceder"
        android:textColor="#E2E8F0"
        android:textAlignment="center"
        android:padding="8dp"
        android:layout_marginBottom="18dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/previousButton"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:text="Anterior"
            android:textSize="18sp"
            android:backgroundTint="#3B82F6"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:text="Siguiente"
            android:textSize="18sp"
            android:backgroundTint="#8B5CF6"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/startButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="Iniciar"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#14B8A6" />

        <Button
            android:id="@+id/blackButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="Pantalla negra"
            android:layout_marginHorizontal="6dp"
            android:backgroundTint="#F59E0B" />

        <Button
            android:id="@+id/endButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="Finalizar"
            android:layout_marginStart="6dp"
            android:backgroundTint="#EF4444" />
    </LinearLayout>

</LinearLayout>
